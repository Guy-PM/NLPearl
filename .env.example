# --- Database ---
DATABASE_URL="postgresql://nlpearl:nlpearl@localhost:5432/nlpearl_dev"

# --- Backend server ---
PORT=3001
HOST=127.0.0.1

# --- Inbound webhook auth ---
# Shared secret N8N must send as `X-Api-Key` on POST /webhooks/n8n/flow-trigger
N8N_WEBHOOK_API_KEY="change-me"
# Shared secret NLPearl must send as `X-Api-Key` on the consent/call-ended webhooks
# (configured as a webhook "Credential" in the NLPearl dashboard)
NLPEARL_WEBHOOK_API_KEY="change-me"

# --- Outbound: NLPearl API (https://developers.nlpearl.ai) ---
NLPEARL_API_BASE_URL="https://api.nlpearl.ai"
NLPEARL_API_KEY="change-me"

# --- Outbound: PayMe Notification Gateway ---
NOTIFICATION_GATEWAY_URL="https://n8n.payme.io/webhook/60e2eea1-a7b2-4f6d-8786-4bea2d0f383c"
NOTIFICATION_GATEWAY_API_KEY="change-me"

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"
